---
import { COMPANY } from "@/domain/catalog";
---

<footer class="site-footer">
  <div class="footer-wrap">
    <div class="footer-lead">
      <div class="footer-lead-copy">
        <span class="footer-eyebrow tabular">{COMPANY.legalName}</span>
        <h2>Siap memenuhi kebutuhan web, desain grafis, dan software resmi Anda?</h2>
      </div>
      <div class="footer-lead-actions">
        <a class="footer-btn-primary" href="/hubungi">
          <span>Minta Penawaran</span>
          <svg class="ph-icon ph-icon-sm" aria-hidden="true">
            <use href="#ph-arrow-right"></use>
          </svg>
        </a>
        <a
          class="footer-btn-secondary"
          href={COMPANY.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="ph-icon ph-icon-sm" aria-hidden="true">
            <use href="#ph-whatsapp-logo"></use>
          </svg>
          <span>Chat WhatsApp</span>
        </a>
      </div>
    </div>

    <div class="footer-grid">
      <div class="footer-brand-col">
        <a class="brand footer-brand-link" href="/" aria-label="Kembali ke Beranda">
          <img
            src="/logo-itb-green.png"
            alt="Logo Imajitek Studio"
            width="47"
            height="24"
            class="brand-logo"
          />
          <span>{COMPANY.brandName}</span>
        </a>
        <p>
          Layanan pembuatan website dan aplikasi web, desain grafis untuk korporat, UMKM, &amp;
          personal, serta pengadaan langganan software kreatif dan AI resmi.
        </p>
        <div class="footer-contact-links">
          <a
            class="footer-contact-pill"
            href={COMPANY.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="ph-icon ph-icon-sm" aria-hidden="true">
              <use href="#ph-whatsapp-logo"></use>
            </svg>
            <span>{COMPANY.whatsappDisplay}</span>
          </a>
          <a class="footer-contact-pill" href={`mailto:${COMPANY.email}`}>
            <svg class="ph-icon ph-icon-sm" aria-hidden="true">
              <use href="#ph-envelope"></use>
            </svg>
            <span>{COMPANY.email}</span>
          </a>
          <a
            class="footer-contact-pill"
            href={COMPANY.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="ph-icon ph-icon-sm" aria-hidden="true">
              <use href="#ph-map-pin"></use>
            </svg>
            <span>{COMPANY.address}</span>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Layanan</h4>
        <ul class="footer-links">
          <li><a href="/web-desain?spec=W">Pembuatan Website &amp; Web App</a></li>
          <li><a href="/web-desain?spec=D">Desain Grafis Korporat &amp; UMKM</a></li>
          <li><a href="/web-desain?spec=D">Desain Visual Personal</a></li>
          <li><a href="/web-desain?spec=S">Standar &amp; Cara Kerja</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Software &amp; AI</h4>
        <ul class="footer-links">
          <li><a href="/software?cat=creative&pick=adobe-cc">Adobe Creative Cloud Pro</a></li>
          <li><a href="/software?cat=creative&pick=canva">Canva Pro &amp; Business</a></li>
          <li><a href="/software?cat=creative&pick=magnific">Magnific &amp; Envato Elements</a></li>
          <li><a href="/software?cat=ai&pick=chatgpt">ChatGPT, Claude &amp; Gemini</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Navigasi</h4>
        <ul class="footer-links">
          <li><a href="/">Beranda</a></li>
          <li><a href="/web-desain">Web &amp; Desain</a></li>
          <li><a href="/software">Katalog Software</a></li>
          <li><a href="/hubungi">Info &amp; Minta Penawaran</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {COMPANY.copyrightYear} {COMPANY.legalName}. Seluruh hak cipta dilindungi.</span>
      <span>{COMPANY.brandName} · {COMPANY.address}</span>
    </div>
  </div>

  <div class="footer-wordmark-wrap" aria-hidden="true">
    <div class="footer-wordmark">IMAJITEK STUDIO</div>
  </div>
</footer>
