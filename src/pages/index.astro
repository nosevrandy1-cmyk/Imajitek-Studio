---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroLauncher from "@/components/islands/HeroLauncher";
import HeroCardsCarousel from "@/components/islands/HeroCardsCarousel";
import CatalogBuilder from "@/components/islands/CatalogBuilder";
import OrderHookSection from "@/components/islands/OrderHookSection";
import FaqDrum from "@/components/islands/FaqDrum";
import { CATALOG_ITEMS, COMPANY, HOME_FAQ_ITEMS, SOFTWARE_SUITE_DIRECTORY } from "@/domain/catalog";

const homeStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: HOME_FAQ_ITEMS.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer
        }
      }))
    },
    {
      "@type": "OfferCatalog",
      name: "Katalog Software Resmi & Jasa Digital Imajitek Studio",
      url: COMPANY.siteUrl,
      numberOfItems: CATALOG_ITEMS.length,
      itemListElement: [
        ...CATALOG_ITEMS.map((item, idx) => ({
          "@type": "ListItem",
          position: idx + 1,
          item: {
            "@type": item.type === "license" ? "SoftwareApplication" : "Service",
            name: item.label,
            description: item.sub,
            provider: { "@id": `${COMPANY.siteUrl}/#organization` }
          }
        })),
        ...SOFTWARE_SUITE_DIRECTORY.map((suite, idx) => ({
          "@type": "ListItem",
          position: CATALOG_ITEMS.length + idx + 1,
          item: {
            "@type": "Product",
            name: suite.suite,
            brand: { "@type": "Brand", name: suite.vendor },
            description: `${suite.summary} Mencakup: ${suite.includedTools.join(", ")}.`
          }
        }))
      ]
    }
  ]
});
---

<BaseLayout
  title="Imajitek Studio | PT Imaji Teknologi Bersama"
  description="Imajitek Studio (PT Imaji Teknologi Bersama) mengerjakan pembuatan website, desain UI/UX di Figma, dan pengadaan lisensi resmi Adobe Creative Cloud Pro, Canva, Magnific, Envato Elements, ChatGPT, Claude, dan Gemini."
  canonicalPath="/"
>
  <script slot="head" type="application/ld+json" set:html={homeStructuredData} />
  <section class="hero-band">
    <div class="hero-frame">
      <img
        src="/images/hero-sky.webp"
        alt=""
        width="1600"
        height="825"
        fetchpriority="high"
        decoding="async"
        class="hero-sky-photo"
        aria-hidden="true"
      />
      <div class="hero-sky-scrim" aria-hidden="true"></div>

      <div class="container hero">
        <h1 class="hero-title">
          Pembuatan web, desain grafis, dan <span class="hl-sky">langganan software resmi</span>.
        </h1>
        <p class="hero-sub">
          Kami melayani pembuatan website dan aplikasi web, jasa desain grafis untuk kebutuhan
          korporat, UMKM, maupun personal, serta pengadaan langganan software kreatif dan AI resmi.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-hero-glass" href="#home-catalog">Lihat Katalog Software</a>
          <a class="btn btn-hero-lime" id="hero-inquire-btn" href="/hubungi">
            <span>Minta Penawaran</span>
            <span class="cta-arrow-circle" aria-hidden="true">
              <svg class="ph-icon ph-icon-xs" aria-hidden="true">
                <use href="#ph-arrow-up-right"></use>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <HeroCardsCarousel client:load />
    </div>
  </section>

  <section class="section band-surface" id="home-catalog">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Katalog langganan software resmi &amp; layanan kreatif</h2>
        <p class="section-desc">
          Pilih layanan pembuatan web, paket desain grafis, atau lisensi software yang Anda
          butuhkan. Sesuaikan jumlahnya dan kirimkan daftar pesanan untuk mendapatkan estimasi
          penawaran.
        </p>
      </div>

      <div class="catalog-search-row">
        <HeroLauncher client:load />
      </div>

      <div class="catalog-unified-stack">
        <CatalogBuilder showMarquee={false} client:visible />
        <OrderHookSection client:visible />
      </div>
    </div>
  </section>

  <section class="section band-light faq-band-section" id="home-faq-band">
    <FaqDrum client:visible />
  </section>
</BaseLayout>
