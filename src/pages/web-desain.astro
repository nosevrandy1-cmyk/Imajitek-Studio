---
import BaseLayout from "@/layouts/BaseLayout.astro";
import KeyboardShowcase from "@/components/islands/KeyboardShowcase";
import { COMPANY } from "@/domain/catalog";

const webServiceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Web Development & UI/UX Design Figma",
  provider: { "@id": `${COMPANY.siteUrl}/#organization` },
  areaServed: { "@type": "Country", name: "Indonesia" },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Layanan Website & Desain UI/UX",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: "Website Company Profile & Landing Page" }
      },
      {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: "Portal Klien & Aplikasi Web Custom" }
      },
      {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: "Desain UI/UX & Design System di Figma" }
      }
    ]
  }
});
---

<BaseLayout
  title="Web Development & Desain UI/UX Figma | Imajitek Studio"
  description="Jasa pembuatan website perusahaan, aplikasi web khusus, dan desain UI/UX Design System di Figma dengan serah terima penuh repositori Git dan file master."
  keywords="jasa pembuatan website perusahaan, web development Indonesia, aplikasi web custom, desain UI UX Figma, design system Figma, PT Imaji Teknologi Bersama, Imajitek Studio"
  canonicalPath="/web-desain"
>
  <script slot="head" type="application/ld+json" set:html={webServiceSchema} />
  <section class="page-hero-band">
    <div class="container">
      <div class="page-intro">
        <div class="page-intro-copy">
          <span class="section-eyebrow tabular">WEB DEVELOPMENT &amp; FIGMA</span>
          <h1>Website, Aplikasi Web &amp; Sistem Desain</h1>
          <p>
            Pengerjaan website perusahaan, aplikasi web khusus, hingga design system Figma yang
            terstruktur dan sepenuhnya menjadi milik Anda.
          </p>
        </div>
        <div class="page-intro-aside">
          <a class="btn btn-nvidia" href="/hubungi?topic=Pembuatan%20Website%20%2F%20Web%20App">
            <span>Diskusikan Proyek</span>
            <svg class="ph-icon ph-icon-sm" aria-hidden="true">
              <use href="#ph-arrow-right"></use>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-compact band-surface">
    <div class="container">
      <div class="faq-grid" style="margin-top:0;margin-bottom:44px;">
        <article class="faq-card">
          <div class="faq-card-head">
            <svg class="ph-icon ph-icon-lg" aria-hidden="true"><use href="#phd-code"></use></svg>
            <h3>Website &amp; Landing Page</h3>
          </div>
          <p>
            Halaman profil perusahaan, katalog produk, atau kampanye pemasaran yang responsif, cepat
            dimuat, dan mudah dikelola melalui CMS.
          </p>
        </article>
        <article class="faq-card">
          <div class="faq-card-head">
            <svg class="ph-icon ph-icon-lg" aria-hidden="true"><use href="#ph-terminal"></use></svg>
            <h3>Portal &amp; Aplikasi Web</h3>
          </div>
          <p>
            Sistem operasional, portal klien, atau dashboard internal dengan otorisasi peran
            pengguna, integrasi API, dan manajemen data terstruktur.
          </p>
        </article>
        <article class="faq-card">
          <div class="faq-card-head">
            <svg class="brand-svg" aria-hidden="true"><use href="#brand-figma"></use></svg>
            <h3>Desain UI/UX di Figma</h3>
          </div>
          <p>
            Perancangan alur pengguna, antarmuka final, komponen Auto Layout, variabel warna/teks,
            serta prototipe interaktif sebelum tahap coding.
          </p>
        </article>
      </div>

      <div class="section-head align-left" style="margin-bottom:20px;">
        <h2 class="section-title" style="margin-bottom:6px;">
          Standar kerja yang selalu kami jaga
        </h2>
        <p class="section-desc">
          Tekan tombol <strong>W</strong>, <strong>D</strong>, <strong>L</strong>, atau{" "}
          <strong>S</strong> untuk menelusuri detailnya.
        </p>
      </div>

      <KeyboardShowcase client:load />
    </div>
  </section>
</BaseLayout>
