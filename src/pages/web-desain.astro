---
import BaseLayout from "@/layouts/BaseLayout.astro";
import KeyboardShowcase from "@/components/islands/KeyboardShowcase";
import { COMPANY } from "@/domain/catalog";

const webServiceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Pembuatan Website, Aplikasi Web & Desain Grafis",
  provider: { "@id": `${COMPANY.siteUrl}/#organization` },
  areaServed: { "@type": "Country", name: "Indonesia" },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Layanan Web Development & Desain Grafis",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Website Perusahaan, Landing Page & Aplikasi Web"
        }
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Desain Grafis Korporat, UMKM & Personal"
        }
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Standar & Alur Kerja Transparan"
        }
      }
    ]
  }
});
---

<BaseLayout
  title="Web, Aplikasi Web & Desain Grafis | Imajitek Studio"
  description="Solusi website, aplikasi web kustom, dan desain grafis profesional untuk skala korporat, UMKM, maupun proyek personal dengan serah terima penuh repositori Git dan file master."
  keywords="jasa pembuatan website perusahaan, aplikasi web custom, jasa desain grafis korporat UMKM personal, logo kemasan company profile, PT Imaji Teknologi Bersama, Imajitek Studio"
  canonicalPath="/web-desain"
>
  <script slot="head" type="application/ld+json" set:html={webServiceSchema} />
  <section class="page-hero-band">
    <div class="container">
      <div class="page-intro">
        <div class="page-intro-copy">
          <span class="section-eyebrow tabular">LAYANAN PENGEMBANGAN &amp; VISUAL</span>
          <h1>Solusi website, aplikasi web, dan desain grafis siap pakai.</h1>
          <p>
            Mulai dari sistem web fungsional hingga desain visual yang memperkuat citra brand.
            Tersedia untuk skala korporat, UMKM, maupun proyek personal dengan serah terima aset
            secara penuh.
          </p>
        </div>
        <div class="page-intro-aside">
          <a class="btn btn-nvidia" href="/hubungi?topic=Pembuatan%20Web%20%26%20Aplikasi">
            <span>Konsultasikan Kebutuhan Anda</span>
            <svg class="ph-icon ph-icon-sm" aria-hidden="true">
              <use href="#ph-arrow-right"></use>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-compact band-surface">
    <div class="container">
      <KeyboardShowcase client:load />
    </div>
  </section>
</BaseLayout>
