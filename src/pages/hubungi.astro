---
import BaseLayout from "@/layouts/BaseLayout.astro";
import InquiryForm from "@/components/islands/InquiryForm";
import { COMPANY } from "@/domain/catalog";
---

<BaseLayout
  title="Info Pembelian & Hubungi Kami | Imajitek Studio"
  description="Hubungi Imajitek Studio melalui WhatsApp +62 813-3887-6110, email imajistudio.id@gmail.com, atau kunjungi Jl. Kertamukti No. 64. Formulir permintaan penawaran resmi dilindungi anti-spam."
  canonicalPath="/hubungi"
>
  <div class="view-header">
    <div>
      <div class="view-breadcrumb">
        <a href="/">Beranda</a>
        <span>/</span>
        <span>Info &amp; Hubungi Kami</span>
      </div>
      <h1>Info Pembelian &amp; Konsultasi Proyek</h1>
      <p>
        Hubungi kami langsung via WhatsApp, email resmi, kunjungi lokasi studio, atau kirim rincian
        proyek Anda melalui formulir di bawah.
      </p>
    </div>
  </div>

  <section class="section-compact">
    <div class="rfq-section">
      <div>
        <h2
          style="margin:0 0 12px;font-size:28px;line-height:1.18;letter-spacing:-0.03em;text-wrap:balance;"
        >
          Ceritakan website, desain, atau software yang Anda butuhkan
        </h2>
        <p style="margin:0 0 22px;color:var(--ink-secondary);font-size:15px;">
          Tulis kebutuhan proyek atau daftar software beserta jumlah penggunanya. Tim kami membalas
          langsung ke WhatsApp atau email Anda.
        </p>

        <div class="contact-direct-list">
          <a
            class="contact-direct-card"
            href={COMPANY.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-direct-icon">
              <svg class="ph-icon ph-icon-sm" aria-hidden="true">
                <use href="#ph-whatsapp-logo"></use>
              </svg>
            </span>
            <span class="contact-direct-meta">
              <small>WhatsApp Resmi</small>
              <strong>{COMPANY.whatsappDisplay}</strong>
            </span>
          </a>

          <a class="contact-direct-card" href={`mailto:${COMPANY.email}`}>
            <span class="contact-direct-icon">
              <svg class="ph-icon ph-icon-sm" aria-hidden="true">
                <use href="#ph-envelope"></use>
              </svg>
            </span>
            <span class="contact-direct-meta">
              <small>Email Resmi</small>
              <strong>{COMPANY.email}</strong>
            </span>
          </a>

          <a
            class="contact-direct-card"
            href={COMPANY.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-direct-icon">
              <svg class="ph-icon ph-icon-sm" aria-hidden="true">
                <use href="#ph-map-pin"></use>
              </svg>
            </span>
            <span class="contact-direct-meta">
              <small>Alamat Studio &amp; Kantor (Buka Google Maps)</small>
              <strong>{COMPANY.address}</strong>
            </span>
          </a>
        </div>

        <div class="rfq-checklist" style="margin-top:18px;">
          <div class="rfq-check-item">
            <svg class="ph-icon" aria-hidden="true"><use href="#ph-check-circle"></use></svg>
            <span>Aktivasi lisensi langsung ke email Anda atau tim</span>
          </div>
          <div class="rfq-check-item">
            <svg class="ph-icon" aria-hidden="true"><use href="#ph-brackets-curly"></use></svg>
            <span>Serah terima penuh repositori Git &amp; file Figma</span>
          </div>
          <div class="rfq-check-item">
            <svg class="ph-icon" aria-hidden="true"><use href="#phd-shield-check"></use></svg>
            <span>Dilindungi verifikasi anti-spam &amp; enkripsi HTTPS</span>
          </div>
        </div>
      </div>

      <InquiryForm variant="contact" client:load />
    </div>
  </section>
</BaseLayout>
