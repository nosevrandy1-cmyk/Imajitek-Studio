---
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";

import "@/styles/tokens.css";
import "@/styles/base.css";
import "@/styles/components.css";

import { COMPANY } from "@/domain/catalog";
import IconSprite from "@/components/IconSprite.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import CommandPalette from "@/components/islands/CommandPalette";

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title = `${COMPANY.brandName} | ${COMPANY.legalName}`,
  description = "Imajitek Studio (PT Imaji Teknologi Bersama) mengerjakan pembuatan website, desain UI/UX di Figma, dan pengadaan lisensi resmi Adobe Creative Cloud Pro, Canva, Magnific, Envato Elements, ChatGPT, Claude, dan Gemini.",
  canonicalPath = "/",
  keywords = "Imajitek Studio, PT Imaji Teknologi Bersama, lisensi Adobe resmi, Adobe Creative Cloud Pro, Photoshop, Illustrator, Premiere Pro, Canva Pro, Magnific, Envato Elements, ChatGPT Team, Claude Pro, Google Gemini, Figma, Microsoft 365, Google Workspace, Autodesk, JetBrains, jasa pembuatan website, desain UI UX Figma, invoice Rupiah",
  ogImage = "/images/og-imajitek.webp"
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, COMPANY.siteUrl).toString();
const ogImageUrl = new URL(ogImage, COMPANY.siteUrl).toString();

const globalSchemaGraph = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${COMPANY.siteUrl}/#organization`,
      name: COMPANY.brandName,
      alternateName: ["Imajitek", COMPANY.legalName, "Imaji Teknologi Bersama"],
      legalName: COMPANY.legalName,
      url: COMPANY.siteUrl,
      logo: {
        "@type": "ImageObject",
        url: `${COMPANY.siteUrl}/favicon-192x192.png`
      },
      image: ogImageUrl,
      email: COMPANY.email,
      telephone: `+${COMPANY.whatsappE164}`,
      priceRange: "IDR",
      areaServed: {
        "@type": "Country",
        name: "Indonesia"
      },
      address: {
        "@type": "PostalAddress",
        streetAddress: COMPANY.address,
        addressCountry: "ID"
      },
      hasMap: COMPANY.mapsUrl,
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        telephone: `+${COMPANY.whatsappE164}`,
        email: COMPANY.email,
        availableLanguage: ["Indonesian", "English"]
      },
      knowsAbout: [
        "Website Development",
        "Web Application Development",
        "UI/UX Design Figma",
        "Design System",
        "Adobe Creative Cloud Pro",
        "Adobe Photoshop",
        "Adobe Illustrator",
        "Adobe Premiere Pro",
        "Adobe After Effects",
        "Adobe Acrobat Pro",
        "Canva Pro & Business",
        "Magnific AI",
        "Envato Elements",
        "Figma Organization",
        "Autodesk AutoCAD",
        "ChatGPT Team & Plus",
        "Claude Pro & Team",
        "Google Gemini",
        "Microsoft 365 Business",
        "Google Workspace",
        "JetBrains All Products",
        "GitHub Team",
        "Cloudflare Business"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${COMPANY.siteUrl}/#website`,
      url: COMPANY.siteUrl,
      name: COMPANY.brandName,
      inLanguage: "id-ID",
      publisher: { "@id": `${COMPANY.siteUrl}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: `${COMPANY.siteUrl}/software?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    }
  ]
});
---

<!doctype html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" title="AI & LLM Reference" href="/llms.txt" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={COMPANY.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={globalSchemaGraph} />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Langsung ke konten utama</a>
    <IconSprite />
    <Navbar currentPath={Astro.url.pathname} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <CommandPalette client:idle />
  </body>
</html>
